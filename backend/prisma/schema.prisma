generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id                 String              @id @default(uuid())
  name               String
  propertyCode       String              @unique
  address            String?
  city               String?
  country            String?
  timezone           String              @default("UTC")
  currency           String              @default("USD")
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  AuditLog           AuditLog[]
  buildings          Building[]
  BusinessDate       BusinessDate[]
  expenses           Expense[]
  ExpenseCategory    ExpenseCategory[]
  folios             Folio[]
  GoodsReceipt       GoodsReceipt[]
  guests             Guest[]
  inventoryItems     InventoryItem[]
  inventoryLocations InventoryLocation[]
  invoices           Invoice[]
  KitchenStation     KitchenStation[]
  ModifierGroup      ModifierGroup[]
  notifications      Notification[]
  payments           Payment[]
  purchaseOrders     PurchaseOrder[]
  reservations       Reservation[]
  orders             RestaurantOrder[]
  outlets            RestaurantOutlet[]
  rooms              Room[]
  roomTypes          RoomType[]
  stays              Stay[]
  StockBalance       StockBalance[]
  stockMovements     StockMovement[]
  suppliers          Supplier[]
  supportSessions    SupportSession[]
  TaxConfig          TaxConfig[]
  users              User[]
  MaintenanceIssue   MaintenanceIssue[]
}

model User {
  id                 String           @id @default(uuid())
  propertyId         String?
  email              String           @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               String
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  notifications      Notification[]
  initiatedSessions  SupportSession[] @relation("SupportInitiator")
  terminatedSessions SupportSession[] @relation("SupportTerminator")
  property           Property?        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model SupportSession {
  id                String    @id @default(uuid())
  sessionReference  String    @unique
  propertyId        String
  initiatedById     String
  reason            String
  scope             String    @default("READ_ONLY")
  status            String    @default("ACTIVE")
  startedAt         DateTime  @default(now())
  expiresAt         DateTime
  terminatedAt      DateTime?
  terminatedById    String?
  terminationReason String?
  initiatedBy       User      @relation("SupportInitiator", fields: [initiatedById], references: [id], onDelete: Cascade)
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  terminatedBy      User?     @relation("SupportTerminator", fields: [terminatedById], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  propertyId String
  userId     String
  action     String
  entity     String
  entityId   String
  before     Json?
  after      Json?
  metadata   Json?
  reason     String?
  ip         String?
  timestamp  DateTime @default(now())
  Property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  @@index([propertyId])
}

model Notification {
  id              String    @id @default(uuid())
  propertyId      String
  recipientId     String?
  type            String
  priority        String    @default("INFORMATIONAL")
  title           String
  message         String
  relatedResource String?
  isRead          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  recipient       User?     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}

model Building {
  id          String   @id @default(uuid())
  propertyId  String
  name        String
  description String?
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floors      Floor[]
}

model Floor {
  id         String   @id @default(uuid())
  buildingId String
  name       String
  level      Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms      Room[]
}

model RoomType {
  id           String        @id @default(uuid())
  propertyId   String
  name         String
  basePrice    Decimal       @db.Decimal(10, 2)
  capacity     Int           @default(2)
  reservations Reservation[]
  rooms        Room[]
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Room {
  id                 String                 @id @default(uuid())
  propertyId         String
  roomTypeId         String
  floorId            String?
  roomNumber         String
  description        String?
  capacityAdults     Int                    @default(2)
  capacityChildren   Int                    @default(0)
  beds               Json?
  amenities          Json?
  images             Json?
  occupancyStatus    RoomOccupancyStatus    @default(VACANT)
  operationalStatus  RoomOperationalStatus  @default(AVAILABLE)
  housekeepingStatus RoomHousekeepingStatus @default(CLEAN)
  housekeepingTasks  HousekeepingTask[]
  floor              Floor?                 @relation(fields: [floorId], references: [id])
  property           Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType           RoomType               @relation(fields: [roomTypeId], references: [id])
  conditions         RoomCondition[]
  stays              Stay[]
  reservations       Reservation[]
  assignments        StayRoomAssignment[]
  MaintenanceIssue   MaintenanceIssue[]
}

model RoomCondition {
  id          String    @id @default(uuid())
  roomId      String
  type        String
  description String
  status      String    @default("OPEN")
  reportedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model HousekeepingTask {
  id             String    @id @default(uuid())
  roomId         String
  taskType       String
  status         String    @default("PENDING")
  priority       String    @default("MEDIUM")
  notes          String?
  workflowStatus String?
  assignedTo     String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  room           Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Guest {
  id             String        @id @default(uuid())
  propertyId     String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  identification String?
  createdAt      DateTime      @default(now())
  folios         Folio[]
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservations   Reservation[]
  stays          Stay[]
}

model Reservation {
  id               String            @id @default(uuid())
  propertyId       String
  guestId          String
  roomTypeId       String
  roomId           String?
  adults           Int               @default(1)
  children         Int               @default(0)
  notes            String?
  expectedCheckIn  DateTime
  expectedCheckOut DateTime
  status           ReservationStatus @default(CONFIRMED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  guest            Guest             @relation(fields: [guestId], references: [id])
  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType         RoomType          @relation(fields: [roomTypeId], references: [id])
  room             Room?             @relation(fields: [roomId], references: [id])
  stays            Stay[]
  @@index([propertyId])
  @@index([propertyId, createdAt])
}

model Stay {
  id               String               @id @default(uuid())
  propertyId       String
  reservationId    String
  guestId          String
  roomId           String
  folioId          String               @unique
  status           String               @default("ACTIVE")
  actualCheckInAt  DateTime
  actualCheckOutAt DateTime?
  orders           RestaurantOrder[]
  folio            Folio                @relation("FolioToStay", fields: [folioId], references: [id])
  guest            Guest                @relation(fields: [guestId], references: [id])
  property         Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation      Reservation          @relation(fields: [reservationId], references: [id])
  room             Room                 @relation(fields: [roomId], references: [id])
  assignments      StayRoomAssignment[]
}

model StayRoomAssignment {
  id           String    @id @default(uuid())
  stayId       String
  roomId       String
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  room         Room      @relation(fields: [roomId], references: [id])
  stay         Stay      @relation(fields: [stayId], references: [id], onDelete: Cascade)
}

model RestaurantOutlet {
  id         String            @id @default(uuid())
  propertyId String
  name       String
  isActive   Boolean           @default(true)
  categories MenuCategory[]
  items      MenuItem[]
  orders     RestaurantOrder[]
  property   Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tables     RestaurantTable[]
}

model RestaurantTable {
  id          String            @id @default(uuid())
  propertyId  String
  outletId    String
  tableNumber String
  status      String            @default("AVAILABLE")
  orders      RestaurantOrder[]
  outlet      RestaurantOutlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
}

model MenuCategory {
  id       String           @id @default(uuid())
  outletId String
  name     String
  outlet   RestaurantOutlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  items    MenuItem[]
}

model MenuItem {
  id               String                  @id @default(uuid())
  propertyId       String
  outletId         String
  categoryId       String?
  name             String
  code             String?
  description      String?
  price            Decimal                 @db.Decimal(10, 2)
  images           Json?
  foodAvailability String                  @default("AVAILABLE")
  unitOfMeasure    String?                 @default("PORTION")
  kitchenStationId String?
  isActive         Boolean                 @default(true)
  category         MenuCategory?           @relation(fields: [categoryId], references: [id])
  outlet           RestaurantOutlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  modifierGroups   MenuItemModifierGroup[]
  orderItems       OrderItem[]
  recipeItems      RecipeItem[]
}

model ModifierGroup {
  id         String                  @id @default(uuid())
  propertyId String
  name       String
  minSelect  Int                     @default(0)
  maxSelect  Int                     @default(1)
  menuItems  MenuItemModifierGroup[]
  Property   Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  options    ModifierOption[]
}

model ModifierOption {
  id                 String              @id @default(uuid())
  groupId            String
  name               String
  price              Decimal             @default(0) @db.Decimal(10, 2)
  group              ModifierGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]
}

model MenuItemModifierGroup {
  id              String        @id @default(uuid())
  menuItemId      String
  modifierGroupId String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
}

model RestaurantOrder {
  id                 String                @id @default(uuid())
  propertyId         String
  outletId           String
  tableId            String?
  stayId             String?
  serviceType        String
  status             RestaurantOrderStatus @default(DRAFT)
  subtotal           Decimal               @default(0) @db.Decimal(10, 2)
  discountTotal      Decimal               @default(0) @db.Decimal(10, 2)
  discountType       String?
  discountReason     String?
  discountApprovedBy String?
  tax                Decimal               @default(0) @db.Decimal(10, 2)
  grandTotal         Decimal               @default(0) @db.Decimal(10, 2)
  createdAt          DateTime              @default(now())
  kots               KOT[]
  items              OrderItem[]
  outlet             RestaurantOutlet      @relation(fields: [outletId], references: [id])
  property           Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  stay               Stay?                 @relation(fields: [stayId], references: [id])
  table              RestaurantTable?      @relation(fields: [tableId], references: [id])
  @@index([propertyId])
  @@index([propertyId, createdAt])
}

model OrderItem {
  id               String              @id @default(uuid())
  orderId          String
  menuItemId       String
  kotId            String?
  quantity         Decimal             @db.Decimal(10, 2)
  unitPrice        Decimal             @db.Decimal(10, 2)
  discountAmount   Decimal             @default(0) @db.Decimal(10, 2)
  discountType     String?
  discountReason   String?
  subtotal         Decimal             @default(0) @db.Decimal(10, 2)
  total            Decimal             @default(0) @db.Decimal(10, 2)
  notes            String?
  itemNameSnapshot String
  status           String              @default("NEW")
  kot              KOT?                @relation(fields: [kotId], references: [id])
  menuItem         MenuItem            @relation(fields: [menuItemId], references: [id])
  order            RestaurantOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  modifiers        OrderItemModifier[]
}

model OrderItemModifier {
  id               String         @id @default(uuid())
  orderItemId      String
  modifierOptionId String
  priceSnapshot    Decimal        @db.Decimal(10, 2)
  modifierOption   ModifierOption @relation(fields: [modifierOptionId], references: [id])
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model KitchenStation {
  id         String   @id @default(uuid())
  propertyId String
  name       String
  kots       KOT[]
  Property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model KOT {
  id               String          @id @default(uuid())
  orderId          String
  kitchenStationId String
  status           KOTStatus       @default(PENDING)
  createdAt        DateTime        @default(now())
  station          KitchenStation  @relation(fields: [kitchenStationId], references: [id])
  order            RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items            OrderItem[]
}

model Folio {
  id            String      @id @default(uuid())
  propertyId    String
  masterFolioId String?
  folioNumber   String      @unique
  guestId       String?
  stayId        String?     @unique
  status        FolioStatus @default(OPEN)
  currency      String      @default("USD")
  subtotal      Decimal     @default(0) @db.Decimal(10, 2)
  discountTotal Decimal     @default(0) @db.Decimal(10, 2)
  taxTotal      Decimal     @default(0) @db.Decimal(10, 2)
  grandTotal    Decimal     @default(0) @db.Decimal(10, 2)
  paidTotal     Decimal     @default(0) @db.Decimal(10, 2)
  balance       Decimal     @default(0) @db.Decimal(10, 2)
  openedAt      DateTime    @default(now())
  guest         Guest?      @relation(fields: [guestId], references: [id])
  Folio         Folio?      @relation("FolioToFolio", fields: [masterFolioId], references: [id])
  other_Folio   Folio[]     @relation("FolioToFolio")
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  items         FolioItem[]
  invoices      Invoice[]
  payments      Payment[]
  stay          Stay?       @relation("FolioToStay")
  @@index([propertyId])
}

model FolioItem {
  id          String   @id @default(uuid())
  folioId     String
  sourceType  String
  sourceId    String?
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  tax         Decimal  @default(0) @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  folio       Folio    @relation(fields: [folioId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String    @id @default(uuid())
  propertyId    String
  invoiceNumber String    @unique
  folioId       String
  status        String    @default("DRAFT")
  issueDate     DateTime?
  dueDate       DateTime?
  subtotal      Decimal   @db.Decimal(10, 2)
  taxTotal      Decimal   @default(0) @db.Decimal(10, 2)
  grandTotal    Decimal   @db.Decimal(10, 2)
  balance       Decimal   @db.Decimal(10, 2)
  folio         Folio     @relation(fields: [folioId], references: [id])
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payments      Payment[]
}

model Payment {
  id               String        @id @default(uuid())
  propertyId       String
  paymentReference String        @unique
  idempotencyKey   String?       @unique
  folioId          String
  invoiceId        String?
  amount           Decimal       @db.Decimal(10, 2)
  capturedAmount   Decimal       @default(0) @db.Decimal(10, 2)
  currency         String        @default("USD")
  method           String
  status           PaymentStatus @default(CAPTURED)
  receivedAt       DateTime      @default(now())
  folio            Folio         @relation(fields: [folioId], references: [id])
  invoice          Invoice?      @relation(fields: [invoiceId], references: [id])
  property         Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  refunds          Refund[]
  @@index([propertyId])
}

model Refund {
  id              String   @id @default(uuid())
  refundReference String   @unique
  paymentId       String
  amount          Decimal  @db.Decimal(10, 2)
  reason          String?
  authorizedBy    String?
  timestamp       DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model ExpenseCategory {
  id         String    @id @default(uuid())
  propertyId String
  name       String
  expenses   Expense[]
  Property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Expense {
  id            String          @id @default(uuid())
  propertyId    String
  categoryId    String
  expenseNumber String          @unique
  vendor        String?
  expenseDate   DateTime
  amount        Decimal         @db.Decimal(10, 2)
  status        String          @default("PENDING_APPROVAL")
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  property      Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Supplier {
  id             String          @id @default(uuid())
  propertyId     String
  name           String
  purchaseOrders PurchaseOrder[]
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id         String              @id @default(uuid())
  propertyId String
  supplierId String
  poNumber   String              @unique
  status     String              @default("DRAFT")
  createdAt  DateTime            @default(now())
  receipts   GoodsReceipt[]
  property   Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  items      PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  inventoryItemId String
  quantity        Decimal       @db.Decimal(10, 2)
  unitPrice       Decimal       @db.Decimal(10, 2)
  item            InventoryItem @relation(fields: [inventoryItemId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  propertyId      String
  purchaseOrderId String?
  receiptNumber   String             @unique
  receivedAt      DateTime           @default(now())
  property        Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  items           GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id              String            @id @default(uuid())
  goodsReceiptId  String
  inventoryItemId String
  quantity        Decimal           @db.Decimal(10, 2)
  unitCost        Decimal           @db.Decimal(10, 2)
  locationId      String
  goodsReceipt    GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  item            InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  location        InventoryLocation @relation(fields: [locationId], references: [id])
}

model InventoryLocation {
  id           String             @id @default(uuid())
  propertyId   String
  name         String
  type         String
  receiptItems GoodsReceiptItem[]
  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  balances     StockBalance[]
  movements    StockMovement[]
}

model InventoryItem {
  id            String              @id @default(uuid())
  propertyId    String
  name          String
  sku           String              @unique
  unitOfMeasure String
  reorderLevel  Decimal             @default(0) @db.Decimal(10, 2)
  receiptItems  GoodsReceiptItem[]
  property      Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  purchaseItems PurchaseOrderItem[]
  recipeItems   RecipeItem[]
  balances      StockBalance[]
  movements     StockMovement[]
}

model StockBalance {
  id              String            @id @default(uuid())
  propertyId      String
  locationId      String
  inventoryItemId String
  quantity        Decimal           @default(0) @db.Decimal(10, 2)
  item            InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  location        InventoryLocation @relation(fields: [locationId], references: [id])
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([locationId, inventoryItemId])
}

model StockMovement {
  id              String            @id @default(uuid())
  propertyId      String
  locationId      String
  inventoryItemId String
  movementType    String
  quantity        Decimal           @db.Decimal(10, 2)
  referenceType   String?
  referenceId     String?
  createdAt       DateTime          @default(now())
  item            InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  location        InventoryLocation @relation(fields: [locationId], references: [id])
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  @@index([propertyId])
  @@index([propertyId, createdAt])
}

model RecipeItem {
  id              String        @id @default(uuid())
  menuItemId      String
  inventoryItemId String
  quantity        Decimal       @db.Decimal(10, 4)
  item            InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, inventoryItemId])
}

model BusinessDate {
  id         String    @id
  propertyId String
  date       DateTime
  status     String
  openedAt   DateTime
  closedAt   DateTime?
  Property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model TaxConfig {
  id          String   @id
  propertyId  String
  name        String
  rate        Decimal  @db.Decimal(10, 2)
  isInclusive Boolean  @default(false)
  isActive    Boolean  @default(true)
  Property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

enum FolioStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
  CLOSED
}

enum KOTStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PRE_AUTH
  CAPTURED
  REFUNDED
  VOIDED
  FAILED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum RestaurantOrderStatus {
  DRAFT
  PLACED
  PREPARING
  SERVED
  COMPLETED
  CANCELLED
}

enum RoomHousekeepingStatus {
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
  READY
}

enum RoomOccupancyStatus {
  VACANT
  OCCUPIED
  RESERVED
}

enum RoomOperationalStatus {
  AVAILABLE
  MAINTENANCE
  OUT_OF_SERVICE
  BLOCKED
}

model MaintenanceIssue {
  id            String    @id @default(uuid())
  propertyId    String
  roomId        String
  issue         String
  priority      String    @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  status        String    @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED
  assignedTo    String?
  notes         String?
  estimatedCost Decimal?  @db.Decimal(10, 2)
  actualCost    Decimal?  @db.Decimal(10, 2)
  createdBy     String
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id])
}
