# Copy to .env for local development. Never commit real credentials.
DATABASE_URL="postgresql://hotel_user:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/hotel_os?schema=public"
# Generate a cryptographically random secret (at least 32 random bytes) and store it in your secret manager.
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Comma-separated trusted browser origins; do not use * in production.
CORS_ORIGINS="http://localhost:3000"
