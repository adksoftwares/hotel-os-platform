# Copy to .env for local Docker Compose use. Never commit the populated .env file.
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=hotel_os
POSTGRES_PORT=5432

# Match the values above when running the backend directly on the host.
DATABASE_URL="postgresql://hotel_user:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@localhost:5432/hotel_os?schema=public"
